{
  "name": "study-partner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/pdf-worker.mjs",
    "predev": "node scripts/pdf-worker.mjs",
    "prebuild": "node scripts/pdf-worker.mjs",
    "materials:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-materials.ts",
    "test:materials": "tsx --test tests/materials.test.ts",
    "test:ai": "node --conditions=react-server --import tsx --test tests/ai.test.ts",
    "test:voice": "node --conditions=react-server --import tsx --test tests/voice.test.ts tests/voice-config.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:e2e": "playwright test",
    "test:auth": "tsx --test tests/auth.integration.ts tests/database.test.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:db:stop": "tsx scripts/test-db.ts --stop",
    "db:check": "tsx scripts/migrate.ts --check",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@elevenlabs/elevenlabs-js": "^2.70.0",
    "@elevenlabs/react": "^1.16.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "eventsource-parser": "^4.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
