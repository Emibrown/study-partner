DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional for private PDF uploads. Pasted notes work without R2.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=study-partner-materials
R2_ACCESS_KEY_ID=your-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret-access-key

# Server-only. Backboard routes generation through OpenRouter; no direct OpenRouter key.
BACKBOARD_API_KEY=

# Private ElevenLabs agent. See VOICE.md for provider configuration.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM_SECRET=
ELEVENLABS_WEBHOOK_SECRET=
# Optional sanitized voice tracing; disabled unless set to 1.
VOICE_TRACE=0
# Controlled fictional-session test only. Leave disabled during normal use.
VOICE_DIAGNOSTIC_MODE=
VOICE_DIAGNOSTIC_SESSION_ID=
VOICE_DIAGNOSTIC_USER_ID=
